{
    "name": "durimjusaj/cron-bundle",
    "type": "symfony-bundle",
    "description": "Symfony cron",
    "license": "MIT",
    "authors": [
        {
            "name": "Dries De Peuter",
            "email": "dries@nousefreak.be"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-pcntl": "*",
        "ext-posix": "*",
        "cron/cron": "^1.0.1",
        "doctrine/collections": "^2.2",
        "doctrine/dbal": "^4.0",
        "doctrine/orm": "^3.6",
        "doctrine/persistence": "^4.0",
        "symfony/config": "^8.0",
        "symfony/console": "^8.0",
        "symfony/dependency-injection": "^8.0",
        "symfony/http-kernel": "^8.0",
        "symfony/process": "^8.0"
    },
    "autoload": {
        "psr-4" : {
            "Cron\\CronBundle\\" : ""
        },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": { "Cron\\CronBundle\\Tests\\": "Tests/" }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "2.0-dev"
        }
    },
    "require-dev": {
        "doctrine/doctrine-bundle": "*",
        "monolog/monolog": "*",
        "phpunit/phpunit": "^12.5",
        "symfony/security-csrf": "^8.0",
        "symfony/translation": "^8.0",
        "symfony/yaml": "^8.0"
    }
}
